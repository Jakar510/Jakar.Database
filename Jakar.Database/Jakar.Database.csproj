		<TreatWarningsAsErrors>False</TreatWarningsAsErrors>
		<IsAotCompatible>False</IsAotCompatible>
		<IsTrimmable>False</IsTrimmable>
		<!-- Jakar.Json's attributes are [Conditional]: keep them in this assembly's metadata, so [JsonModel] records in other assemblies see them on the members they inherit (PairRecord.AdditionalData's [JsonOverflow]). -->
		<DefineConstants>$(DefineConstants);JAKAR_JSON_KEEP_ATTRIBUTES</DefineConstants>
